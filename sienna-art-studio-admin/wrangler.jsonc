{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "sienna-art-studio-admin",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "admin.siennaartstudio.shop", "custom_domain": true }
	],
	// Secrets (SHOPIFY_CLIENT_SECRET, ADMIN_PASSWORD_HASH, SESSION_SECRET) live only in the Cloudflare dashboard.
	"vars": {
		"SHOPIFY_STORE": "sienna-art-studio-eiknbuj0",
		"SHOPIFY_CLIENT_ID": "b625b02190432a2e4ec1284cb21d98fc",
		"ADMIN_USERNAME": "sabo"
	}
}
