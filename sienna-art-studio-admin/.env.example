# Copy to .env.local (local) or add the same names in the hosting dashboard (production).
# Never commit the real values.

# --- Shopify (see SETUP.md, steps 1-3) ---
SHOPIFY_STORE=sienna-art-studio-eiknbuj0
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if you use an old-style custom app token instead of the two lines above:
# SHOPIFY_ADMIN_TOKEN=shpat_...

# --- Panel login (see SETUP.md, step 4) ---
ADMIN_USERNAME=admin
# create with:  npm run hash -- "your password"
ADMIN_PASSWORD_HASH=
# random string, 32+ characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
