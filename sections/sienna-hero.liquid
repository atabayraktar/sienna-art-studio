{%- liquid
  assign main_img = section.settings.image
  if main_img == blank
    assign main_img = section.settings.product.featured_image
  endif
  assign back_img = section.settings.image_back
  if back_img == blank
    assign back_img = section.settings.product_back.featured_image
  endif
  assign head_lines = section.settings.heading | split: '|'
-%}

<section class="s-hero" data-hero data-lights="off" id="Hero-{{ section.id }}">
  <svg class="s-hero__waves" viewBox="0 0 1440 760" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="w1" d="M0 0h1440v150c-120 70-260 90-390 40s-250-120-410-70S300 250 150 210 0 170 0 170Z"/>
    <path class="w2" d="M0 560c140-60 270-40 400 20s290 100 450 40 330-120 590-30v170H0Z"/>
  </svg>

  <div class="s-hero__grid page-width">
    <div class="s-hero__copy">
      <h1 class="s-hero__title">
        {%- for line in head_lines -%}
          <span class="s-hero__line">
            {%- if forloop.last and section.settings.glow_last_word -%}
              {%- assign words = line | split: ' ' -%}
              {%- assign last = words | last -%}
              {%- assign lead = line | remove: last -%}
              {{- lead -}}<span class="s-hero__glow">{{ last }}</span>
            {%- else -%}
              {{- line -}}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </h1>
      <p class="s-hero__sub">{{ section.settings.subheading }}</p>
      <div class="s-hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="s-btn s-btn--solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
            <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="s-btn s-btn--line" href="{{ section.settings.button_link_2 | default: routes.collections_url }}">
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>

    </div>

    <div class="s-hero__art" data-hero-art>
      <div class="s-hero__block" data-depth="1">
        {%- if back_img != blank -%}
          {{
            back_img
            | image_url: width: 900
            | image_tag:
              class: 's-hero__back-img',
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 990px) 28vw, 60vw',
              loading: 'eager',
              alt: ''
          }}
        {%- endif -%}
      </div>
      <figure class="s-hero__frame" data-depth="2">
        {%- if main_img != blank -%}
          {{
            main_img
            | image_url: width: 1200
            | image_tag:
              class: 's-hero__img',
              widths: '480, 640, 800, 1000, 1200',
              sizes: '(min-width: 990px) 40vw, 86vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image_alt
          }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 's-hero__img placeholder-svg' }}
        {%- endif -%}
        <span class="s-hero__bloom" aria-hidden="true"></span>
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sienna hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (use | for a line break)", "default": "Gifts That Make|Every Moment Shine." },
    { "type": "checkbox", "id": "glow_last_word", "label": "Glow on the last word when the lights are on", "default": true },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover unique gifts, beautiful lighting, personalized creations, and little surprises you'll love." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Personalized gifts" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Main image" },
    { "type": "image_picker", "id": "image", "label": "Image (lifestyle photo)" },
    { "type": "product", "id": "product", "label": "Or use a product's first image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "A lit mosaic lamp throwing colored patterns across a wall" },
    { "type": "header", "content": "Back layer" },
    { "type": "image_picker", "id": "image_back", "label": "Back image" },
    { "type": "product", "id": "product_back", "label": "Or use a product's first image" },
    { "type": "header", "content": "Floating card" },
    { "type": "text", "id": "tag_title", "label": "Title", "default": "New arrivals" },
    { "type": "text", "id": "tag_text", "label": "Text", "default": "The mosaic lamp edit" },
    { "type": "url", "id": "tag_link", "label": "Link" }
  ],
  "presets": [{ "name": "Sienna hero" }]
}
{% endschema %}
