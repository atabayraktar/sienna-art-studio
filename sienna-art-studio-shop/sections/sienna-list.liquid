<section class="s-list" id="contact">
  <div class="page-width">
    <div class="s-list__card">
      <span class="s-list__badge" aria-hidden="true">
        <img src="{{ 'sienna-logo-badge.svg' | asset_url }}" alt="" width="62" height="62" loading="lazy">
      </span>
      <div class="s-list__copy">
        <h2 class="s-list__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="s-list__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="s-list__action">
        {%- form 'customer', id: 'SiennaList', class: 's-list__form-wrap' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="return_to" value="{{ request.path }}">
          <div class="s-list__form{% if form.errors %} is-invalid{% endif %}" data-field>
            <label class="visually-hidden" for="SiennaList-email">Email</label>
            <input
              id="SiennaList-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="Your email"
              value="{{ form.email }}"
              data-msg-required="Add your email to join the list."
              data-msg-type="That email does not look right. Try name@example.com."
              aria-describedby="SiennaList-err"
            >
            <button class="s-btn s-btn--solid" type="submit">Join</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="s-list__msg s-list__msg--ok" role="status">Thanks for joining. Watch your inbox.</p>
          {%- elsif form.errors -%}
            <p class="s-list__err" id="SiennaList-err" role="alert" data-err>That email did not go through. Check it and try again.</p>
          {%- else -%}
            <p class="s-list__err" id="SiennaList-err" role="alert" data-err hidden></p>
            <p class="s-list__fine">{{ section.settings.fine_print }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="s-list__hello">
        <p class="s-list__or"><span>{{ section.settings.hello_or }}</span></p>
        <div class="s-list__hello-copy">
          <h3 class="s-list__hello-title">{{ section.settings.hello_heading }}</h3>
          {%- if section.settings.hello_text != blank -%}
            <p class="s-list__text">{{ section.settings.hello_text }}</p>
          {%- endif -%}
          <ul class="s-list__asks">
            {%- for i in (1..3) -%}
              {%- assign key = 'hello_item_' | append: i -%}
              {%- if section.settings[key] != blank -%}
                <li>{{ section.settings[key] }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        {%- form 'contact', id: 'SiennaContact', class: 's-contact__form' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- if form.posted_successfully? -%}
            <p class="s-list__msg s-list__msg--ok" role="status">Thanks for writing. We will get back to you soon.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="s-list__msg s-list__msg--error" role="alert">Something is missing. Please check the fields below and try again.</p>
          {%- endif -%}
          <div class="s-contact__row">
            <label class="s-field" data-field>
              <span class="visually-hidden">Name</span>
              <input type="text" name="contact[name]" autocomplete="name" placeholder="Your name" required value="{{ form.name }}" data-msg-required="Please tell us your name." aria-describedby="SiennaContact-name-err">
              <span class="s-field__err" id="SiennaContact-name-err" data-err hidden></span>
            </label>
            <label class="s-field" data-field>
              <span class="visually-hidden">Email</span>
              <input type="email" name="contact[email]" autocomplete="email" placeholder="Your email" required value="{{ form.email }}" data-msg-required="Please add your email so we can reply." data-msg-type="That email does not look right. Try name@example.com." aria-describedby="SiennaContact-email-err">
              <span class="s-field__err" id="SiennaContact-email-err" data-err hidden></span>
            </label>
          </div>
          <label class="s-field" data-field>
            <span class="visually-hidden">Message</span>
            <textarea name="contact[body]" rows="4" placeholder="How can we help?" required data-msg-required="Write us a few words so we know how to help." aria-describedby="SiennaContact-body-err">{{ form.body }}</textarea>
            <span class="s-field__err" id="SiennaContact-body-err" data-err hidden></span>
          </label>
          <button class="s-btn s-btn--solid" type="submit">Send message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'sienna-forms.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Sienna email list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Sienna List" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New arrivals, gift ideas and the occasional offer. No spam." },
    { "type": "text", "id": "fine_print", "label": "Small print", "default": "One email now and then. Unsubscribe any time." },
    { "type": "text", "id": "hello_or", "label": "Divider text", "default": "or" },
    { "type": "text", "id": "hello_heading", "label": "Contact heading", "default": "Say hello" },
    { "type": "textarea", "id": "hello_text", "label": "Contact text", "default": "A question about an order, a lamp or a custom piece? A real person will answer." },
    { "type": "text", "id": "hello_item_1", "label": "Contact point 1", "default": "Where is my order?" },
    { "type": "text", "id": "hello_item_2", "label": "Contact point 2", "default": "Custom colors and made-to-order pieces" },
    { "type": "text", "id": "hello_item_3", "label": "Contact point 3", "default": "Help choosing a gift" }
  ],
  "presets": [{ "name": "Sienna email list" }]
}
{% endschema %}
