<section class="s-list s-contact" id="contact">
  <div class="page-width">
    <div class="s-list__card s-contact__card">
      <div class="s-list__copy">
        <h2 class="s-list__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="s-list__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="s-list__action">
        {%- form 'contact', id: 'SiennaContact', class: 's-contact__form' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- if form.posted_successfully? -%}
            <p class="s-list__msg s-list__msg--ok" role="status">Thanks for writing. We will get back to you soon.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="s-list__msg s-list__msg--error" role="alert">Something is missing. Please check the fields below and try again.</p>
          {%- endif -%}
          <div class="s-contact__row">
            <label class="s-field" data-field>
              <span class="visually-hidden">Name</span>
              <input type="text" name="contact[name]" autocomplete="name" placeholder="Your name" required value="{{ form.name }}" data-msg-required="Please tell us your name." aria-describedby="SiennaContact-name-err">
              <span class="s-field__err" id="SiennaContact-name-err" data-err hidden></span>
            </label>
            <label class="s-field" data-field>
              <span class="visually-hidden">Email</span>
              <input type="email" name="contact[email]" autocomplete="email" placeholder="Your email" required value="{{ form.email }}" data-msg-required="Please add your email so we can reply." data-msg-type="That email does not look right. Try name@example.com." aria-describedby="SiennaContact-email-err">
              <span class="s-field__err" id="SiennaContact-email-err" data-err hidden></span>
            </label>
          </div>
          <label class="s-field" data-field>
            <span class="visually-hidden">Message</span>
            <textarea name="contact[body]" rows="4" placeholder="How can we help?" required data-msg-required="Write us a few words so we know how to help." aria-describedby="SiennaContact-body-err">{{ form.body }}</textarea>
            <span class="s-field__err" id="SiennaContact-body-err" data-err hidden></span>
          </label>
          <button class="s-btn s-btn--solid" type="submit">Send message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'sienna-forms.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Sienna contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Say hello" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A question about an order, a lamp or a custom piece? Send us a message and a real person will answer." }
  ],
  "presets": [{ "name": "Sienna contact" }]
}
{% endschema %}
