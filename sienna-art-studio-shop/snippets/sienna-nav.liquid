{%- comment -%}
  Sienna navigation. One data table drives the desktop mega panel and the mobile drawer.
  mode: 'desktop' | 'mobile'
  Collections that do not exist yet still render; they simply link to /collections/<handle>.
{%- endcomment -%}
{%- liquid
  assign menu = shop.metafields.sienna.menu.value
  if menu != blank
    comment
      Menu comes from the admin panel (shop metafield sienna.menu, written on every import).
    endcomment
    assign g_str = ''
    assign s_str = ''
    for mt in menu
      assign g_str = g_str | append: mt.name | append: '~' | append: mt.handle | append: '~' | append: mt.tagline | append: '~' | append: mt.headerImage | append: '||'
      for ms in mt.children
        assign s_str = s_str | append: ms.name | append: '~' | append: ms.handle | append: '~' | append: ms.tagline | append: '^'
      endfor
      assign s_str = s_str | append: '||'
    endfor
    assign groups = g_str | split: '||'
    assign subs_by_group = s_str | split: '||'
  else
    comment
      Fallback until the first import has written the metafield.
    endcomment
    assign groups = 'Home & Lighting~all-lamps~Unique decorative lamps for every space||Personalized Gifts~personalized-gifts~Custom art and gifts made for your people||Toys & Kids~toys-kids~Squishy toys and night lights for kids||Home Decor~home-decor~Small pieces that finish a room' | split: '||'

    assign subs_0 = 'Mosaic & Stained Glass~mosaic-stained-glass~Colorful glass lamps^Modern Lamps~modern~Clean, sculpted lines^Rechargeable Lamps~rechargeable~Cordless, carry anywhere^Crystal Glow Lamps~crystal-glow-lamps~Etched crystal light^Animal Stained Glass Lamps~animal-stained-glass-lamps~Figures in colored glass'
    assign subs_1 = 'Custom Art~custom-art-personalized-gifts~Portraits from your photos^Personalized Gifts~personalized-gifts-all~Made with names and dates^Photo to Cartoon Portraits~photo-to-cartoon-portraits~Your photo, illustrated^Custom Products~custom-products~Made to your request'
    assign subs_2 = 'Squishy Toys~squishy-toys~Soft, slow-rising and silly^Mini Figures~mini-figures~Small collectibles^Kids’ Night Lights~kids-night-lights~Soft glow for bedtime'
    assign subs_3 = 'Wall Art~wall-art~Prints and framed pieces^Decorative Accents~decorative-accents~Shelf and table pieces^Seasonal Decor~seasonal-decor~For every holiday^Gift Ideas~gift-ideas~Ready to wrap'

    assign subs_by_group = subs_0 | append: '||' | append: subs_1 | append: '||' | append: subs_2 | append: '||' | append: subs_3 | split: '||'
  endif
-%}

{%- if mode == 'title' -%}
  {%- liquid
    for g in groups
      assign gp = g | split: '~'
      if gp[1] == handle
        echo gp[0]
        break
      endif
      assign subs = subs_by_group[forloop.index0] | split: '^'
      for s in subs
        assign sp = s | split: '~'
        if sp[1] == handle
          echo sp[0]
          break
        endif
      endfor
    endfor
  -%}
{%- elsif mode == 'desktop' -%}
  <nav class="sn" aria-label="Main">
    <ul class="sn__list">
      <li class="sn__item sn__item--has-panel" data-sn-item>
        <button
          class="sn__link"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="SiennaShopPanel"
          data-sn-trigger
        >
          Shop
          <svg class="sn__caret" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </li>
      {%- for g in groups -%}
        {%- assign gp = g | split: '~' -%}
        <li class="sn__item">
          <a class="sn__link" href="{{ routes.collections_url }}/{{ gp[1] }}">{{ gp[0] }}</a>
        </li>
      {%- endfor -%}
      <li class="sn__item">
        <a class="sn__link" href="{{ routes.root_url }}#contact">Contact</a>
      </li>
    </ul>

    <div class="sn-panel" id="SiennaShopPanel" data-sn-panel hidden>
      <div class="sn-panel__inner page-width">
        {%- for g in groups -%}
          {%- liquid
            assign gp = g | split: '~'
            assign idx = forloop.index0
            assign subs = subs_by_group[idx] | split: '^'
            assign top_col = collections[gp[1]]
            assign top_img = top_col.featured_image
            if top_img == blank
              for s in subs
                assign sp = s | split: '~'
                assign sc = collections[sp[1]]
                if sc.featured_image != blank
                  assign top_img = sc.featured_image
                  break
                endif
              endfor
            endif
          -%}
          <section class="sn-col" data-sn-col="{{ idx }}">
            <a class="sn-col__head" href="{{ routes.collections_url }}/{{ gp[1] }}">
              <span class="sn-col__hero">
                {%- comment -%}Wide menu picture from the Excel (Header Image URL); product photo only when the Excel has none.{%- endcomment -%}
                {%- capture top_photo -%}
                  {%- if gp[3] != blank -%}
                    <img src="{{ gp[3] }}" alt="" width="1500" height="500" loading="lazy">
                  {%- else -%}
                    {%- render 'sienna-photo', top: idx, width: 640, sizes: '300px' -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- if top_photo != blank -%}
                  {{ top_photo }}
                {%- else -%}
                  <span class="sn-col__ph" aria-hidden="true">{{ gp[0] | slice: 0 }}</span>
                {%- endif -%}
              </span>
              <h3 class="sn-col__title">{{ gp[0] }}</h3>
              <p class="sn-col__tag">{{ gp[2] }}</p>
            </a>
            <a class="sn-col__all" href="{{ routes.collections_url }}/{{ gp[1] }}">View all</a>
            <ul class="sn-col__subs">
              {%- for s in subs -%}
                {%- assign sp = s | split: '~' -%}
                {%- assign sc = collections[sp[1]] -%}
                <li>
                  <a class="sn-sub" href="{{ routes.collections_url }}/{{ sp[1] }}">
                    {%- capture sub_photo -%}{%- render 'sienna-photo', handle: sp[1], width: 160, sizes: '48px' -%}{%- endcapture -%}
                    {%- if sub_photo != blank -%}
                      <span class="sn-sub__thumb">{{ sub_photo }}</span>
                    {%- else -%}
                      <span class="sn-sub__thumb sn-sub__thumb--empty" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="sn-sub__text">
                      <span class="sn-sub__name">{{ sp[0] }}</span>
                      <span class="sn-sub__desc">{{ sp[2] }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endfor -%}
      </div>
      <div class="sn-panel__foot page-width">
        <a class="sn-panel__shopall" href="{{ routes.all_products_collection_url }}">
          Shop all products
          <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true"><path d="M1 5h12M9 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </nav>
{%- elsif mode == 'sidebar' -%}
  <nav class="s-side" aria-label="Categories">
    <details class="s-side__wrap" data-s-side>
      <summary class="s-side__toggle">Categories</summary>
      <a class="s-side__all{% if collection.handle == 'all' %} is-current{% endif %}" href="{{ routes.all_products_collection_url }}">All products</a>
      {%- for g in groups -%}
        {%- liquid
          assign gp = g | split: '~'
          assign subs = subs_by_group[forloop.index0] | split: '^'
        -%}
        <div class="s-side__group">
          <a class="s-side__head{% if collection.handle == gp[1] %} is-current{% endif %}" href="{{ routes.collections_url }}/{{ gp[1] }}">{{ gp[0] }}</a>
          <ul class="s-side__subs">
            {%- for s in subs -%}
              {%- assign sp = s | split: '~' -%}
              <li><a class="s-side__sub{% if collection.handle == sp[1] %} is-current{% endif %}" href="{{ routes.collections_url }}/{{ sp[1] }}"{% if collection.handle == sp[1] %} aria-current="page"{% endif %}>{{ sp[0] }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </details>
  </nav>
{%- else -%}
  <button class="sm-toggle" type="button" aria-expanded="false" aria-controls="SiennaDrawer" data-sm-open>
    <span class="sm-toggle__bars" aria-hidden="true"><i></i><i></i></span>
    <span class="visually-hidden">Menu</span>
  </button>

  <div class="sm" id="SiennaDrawer" data-sm hidden>
    <div class="sm__scrim" data-sm-close></div>
    <div class="sm__sheet" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sm__top">
        <a class="sm__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          <span class="sienna-logo sienna-logo--light" aria-hidden="true">
            <img class="sienna-logo__text" src="{{ 'sienna-logo-text-light.svg' | asset_url }}" alt="" width="112" height="58">
            <img class="sienna-logo__star" src="{{ 'sienna-logo-star.svg' | asset_url }}" alt="" width="24" height="24">
          </span>
          <span class="sienna-logo sienna-logo--dark" aria-hidden="true">
            <img class="sienna-logo__text" src="{{ 'sienna-logo-text-dark.svg' | asset_url }}" alt="" width="112" height="58">
            <img class="sienna-logo__star" src="{{ 'sienna-logo-star.svg' | asset_url }}" alt="" width="24" height="24">
          </span>
        </a>
        <button class="sm__close" type="button" data-sm-close aria-label="Close menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="sm__actions">
        <a class="s-btn s-btn--line" href="{{ routes.root_url }}#contact" data-sm-close>Contact</a>
        <a class="s-btn s-btn--solid" href="{{ routes.all_products_collection_url }}">Shop all products</a>
      </div>
      {%- for g in groups -%}
        {%- liquid
          assign gp = g | split: '~'
          assign subs = subs_by_group[forloop.index0] | split: '^'
        -%}
        <details class="sm__group">
          <summary>
            <span class="sm__gname">
              {%- capture g_photo -%}{%- render 'sienna-photo', top: forloop.index0, width: 240, sizes: '60px' -%}{%- endcapture -%}
              <span class="sm__thumb{% if g_photo == blank %} sm__thumb--empty{% endif %}">{{ g_photo }}</span>
              <span>{{ gp[0] }}</span>
            </span>
            <svg width="12" height="8" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <ul>
            <li><a href="{{ routes.collections_url }}/{{ gp[1] }}" class="sm__all">View all</a></li>
            {%- for s in subs -%}
              {%- assign sp = s | split: '~' -%}
              <li>
                <a href="{{ routes.collections_url }}/{{ sp[1] }}" class="sm__sub">
                  {%- capture s_photo -%}{%- render 'sienna-photo', handle: sp[1], width: 160, sizes: '44px' -%}{%- endcapture -%}
                  <span class="sm__thumb sm__thumb--sm{% if s_photo == blank %} sm__thumb--empty{% endif %}">{{ s_photo }}</span>
                  <span>{{ sp[0] }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
